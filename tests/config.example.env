# Smoke-test configuration. Copy to tests/config.env and fill in the two
# values below — everything else is a constant of this deployment (CLI
# client, scopes, redirect port live in tests/pf_common.py and the server
# profile; the AWS target comes from agentcore/aws-targets.json).

# PingFederate engine base URL (the runtime host via the ingress).
PF_BASE_URL=https://pf.example.com

# The runtime ID from `agentcore status` (e.g.
# tokenexchangeagent_default_exchange_agent-AbCdEfGhIp).
AGENT_RUNTIME_NAME=

# Optional, rarely needed:
# PF_ADMIN_TOKEN=       # bearer token for the read-only admin-API checks
# PF_ADMIN_BASE_URL=    # only if the admin API lives off the engine host
# PF_EXCHANGE_SCOPE=    # defaults to demo:read
