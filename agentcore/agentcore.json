{
  "name": "tokenexchangeagent",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "exchange_agent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "agent",
      "runtimeVersion": "PYTHON_3_14",
      "instrumentation": {
        "enableOtel": true
      },
      "envVars": [
        {
          "name": "PF_TOKEN_URL",
          "value": "https://ai-agentcore-token-exchange-pingfederate-engine.ping-devops.com/as/token.oauth2"
        },
        {
          "name": "PF_AGENT_CLIENT_ID",
          "value": "arn:aws:iam::574076504146:role/AgentCore-tokenexchangeag-ApplicationRuntimeExchang-cR6Ap8URe01B"
        },
        {
          "name": "EXCHANGE_SCOPES",
          "value": "demo:read"
        }
      ],
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://ai-agentcore-token-exchange-pingfederate-engine.ping-devops.com/.well-known/openid-configuration",
          "allowedAudience": [
            "https://agentcore.demo.internal/invoke"
          ]
        }
      }
    }
  ],
  "credentials": [],
  "memories": [],
  "knowledgeBases": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}
