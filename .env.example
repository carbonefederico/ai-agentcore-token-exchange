# Everything else has a script default or is derived from PF_PUBLIC_HOSTNAME
# (issuer, JWKS URL, token-endpoint audience) or from your AWS session
# (the agent client_id = the agent IAM role ARN). Operator-level credentials
# (Ping DevOps user/key for the license) come from your own environment —
# export them or add to .env; scripts/deploy.sh fails fast if they are
# missing. The server-profile git pointer lives in helm/pingfederate/values.yaml
# (project config, not operator config). Override only to deviate — see
# scripts/deploy.sh for the full list of derivations.

# Public hostname of the PingFederate engines (ingress, cert-manager TLS).
# Must resolve from AWS (AgentCore fetches discovery/JWKS) and from inside
# the cluster (PF's self-JWKS fetch hairpins through the ingress).
PF_PUBLIC_HOSTNAME=

# AWS region for the agent deployment (aws/setup-identity.sh, agentcore CLI).
AWS_REGION=
