#!/usr/bin/env sh
# Post-import: create the authentication policy that grants the DemoApc
# contract. The /authenticationPolicies resource is not supported by the
# bulk-import endpoint in PF 13.x (only via REST), so this hook runs after
# 85-import-configuration has brought the rest of the config up.
#
# Chain (mirrors the operator's working instance):
#   passthrough adapter (authn source) -> Success -> grant DemoApc
#   with subject <- adapter username.
test "${VERBOSE}" = "true" && set -x

# shellcheck source=../../../../pingcommon/opt/staging/hooks/pingcommon.lib.sh
. "${HOOKS_DIR}/pingcommon.lib.sh"

ADMIN_USER="${ADMIN_USER:-Administrator}"
ADMIN_PASS="${ADMIN_PASS:-${PING_IDENTITY_PASSWORD:-2FederateM0re}}"
BASE="https://localhost:9999/pf-admin-api/v1"

# Wait for the admin API to accept the license and expose the endpoint.
i=0
until curl -sk -u "${ADMIN_USER}:${ADMIN_PASS}" -H "X-XSRF-Header: PingFederate" \
      -o /dev/null "${BASE}/idp/adapters" 2>/dev/null; do
  i=$((i + 1))
  if [ "${i}" -gt 60 ]; then
    container_failure 1 "admin API not reachable after 60 attempts"
  fi
  sleep 5
done

# Idempotent: skip when the policy already exists.
if curl -sk -u "${ADMIN_USER}:${ADMIN_PASS}" -H "X-XSRF-Header: PingFederate" \
     -o /dev/null -w '' "${BASE}/authenticationPolicies/DemoAuthnPolicy" 2>/dev/null; then
  echo "INFO: DemoAuthnPolicy already exists; skipping"
else
  echo "Creating authentication policy DemoAuthnPolicy"
  curl -sk -u "${ADMIN_USER}:${ADMIN_PASS}" \
    -H "X-XSRF-Header: PingFederate" \
    -H "Content-Type: application/json" \
    -X POST \
    -d '{
      "id": "DemoAuthnPolicy",
      "name": "Demo Authentication Policy",
      "rootNode": {
        "type": "AUTHN_SOURCE",
        "action": {
          "type": "AUTHN_SOURCE",
          "authenticationSource": {
            "type": "IDP_ADAPTER",
            "sourceRef": {
              "id": "DemoPassthroughAdapter",
              "location": "'"${BASE}"'/idp/adapters/DemoPassthroughAdapter"
            }
          },
          "attributeMapping": {
            "attributeContractFulfillment": {
              "subject": {
                "source": { "type": "ADAPTER" },
                "value": "username"
              }
            },
            "issuanceCriteria": { "conditionalCriteria": [] }
          }
        },
        "children": [
          {
            "type": "APC_MAPPING",
            "context": "Success",
            "action": {
              "type": "APC_MAPPING",
              "authenticationPolicyContractRef": {
                "id": "DemoApc",
                "location": "'"${BASE}"'/authenticationPolicyContracts/DemoApc"
              },
              "attributeMapping": {
                "attributeContractFulfillment": {
                  "subject": {
                    "source": { "type": "ADAPTER" },
                    "value": "username"
                  }
                },
                "issuanceCriteria": { "conditionalCriteria": [] }
              }
            }
          }
        ]
      }
    }' \
    "${BASE}/authenticationPolicies" || \
    die_on_error 1 "authentication policy creation failed" || exit ${?}
fi
