<?xml version="1.0" encoding="UTF-8"?>
<c:config xmlns:c="http://www.sourceid.org/2004/05/config">
    <!-- AWS STS identity JWTs used as client assertions (AgentCore secretless POC):
         iss = STS issuer (not the client id), typ = "JWT" (not client-authentication+jwt).
         The aud claim already matches the PF token endpoint (tokenEndpointBaseUrl default
         derives from federationInfo.baseUrl; AWS sets aud to the full token endpoint URL). -->
    <c:item name="issuerMustBeEqualToClientId">false</c:item>
    <c:item name="JWT_CLIENT_AUTHENTICATION_EXPECTED_TYPE_HEADER">JWT</c:item>
</c:config>
