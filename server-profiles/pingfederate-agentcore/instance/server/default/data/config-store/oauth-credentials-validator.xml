<?xml version="1.0" encoding="UTF-8"?>
<con:config xmlns:con="http://www.sourceid.org/2004/05/config">
    <con:item name="issuerMustBeEqualToClientId">false</con:item>
    <con:item name="jwtClientAuthenticationExpectedType">JWT</con:item>
    <con:item name="Rfc7523bisCompliantAudienceVerification">true</con:item>
    <!-- AgentCore Identity signs the client assertion with aud = the full
         token endpoint; PF's acceptable-audience set (issuer base URL,
         tokenEndpointBaseUrl, request values) needs this one added. -->
    <con:list name="AdditionalAllowedAudiences">
        <con:list-item>https://ai-agentcore-token-exchange-pingfederate-engine.ping-devops.com/as/token.oauth2</con:list-item>
    </con:list>
</con:config>
