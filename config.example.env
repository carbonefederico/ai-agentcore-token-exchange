# Copy to config.env and fill in. The preflight script and the CLI default
# everything not listed here (ports, scopes, AWS region, redirect URI) —
# override only to deviate; see pf_phase0_common.py for the full default list.

# --- PingFederate (runtime engine via the ingress) ---
PF_BASE_URL=https://pf.example.com
# Admin API base URL if different from PF_BASE_URL (usually :9999). Optional;
# preflight skips the admin-API checks when PF_ADMIN_TOKEN is empty.
# PF_ADMIN_BASE_URL=
# PF_ADMIN_TOKEN=

# --- PingFederate CLI client (agentcore-demo-cli) ---
# Confidential client; the demo secret is in the server profile.
PF_CLI_CLIENT_ID=agentcore-demo-cli
PF_CLI_CLIENT_SECRET=cli-demo-secret
# PF_REDIRECT_PORT=8400
# PF_DEMO_SCOPE=openid profile
# PF_EXCHANGE_SCOPE=demo:read

# --- AgentCore (CLI only) ---
# The runtime ID from `agentcore status` (e.g.
# tokenexchangeagent_default_exchange_agent-AbCdEfGhIp).
AGENT_RUNTIME_NAME=
# AWS_ACCOUNT_ID optional — derived from your AWS credentials when unset.
